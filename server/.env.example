# Backend — servidor de confirmación por WhatsApp (Baileys)

# Puerto HTTP
PORT=4000

# Conexión a MongoDB (local con mongod o MongoDB Atlas en producción)
MONGODB_URI=mongodb://127.0.0.1:27017/invitacion-xv

# Contraseña del panel admin (/admin)
ADMIN_PASSWORD=cambiar-esta-clave

# Orígenes permitidos por CORS, separados por coma (dominio del frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Datos del evento para el mensaje personalizado
QUINCEANERA=Tania
EVENT_DATE=28 de noviembre, 2026

# Plantilla por defecto del mensaje (placeholders: {nombre} {quinceanera} {fecha})
# DEFAULT_MESSAGE=Hola {nombre}, recibimos tu confirmación para los XV años de {quinceanera} el {fecha}. ¡Nos vemos ahí! ✨

# Código de país que se agrega si el invitado escribe solo 10 dígitos
DEFAULT_COUNTRY_CODE=52

# Dígito móvil requerido por WhatsApp tras el código de país (México: "1").
# Vacío si el país no lo exige.
# MOBILE_PREFIX=1

# production en Render
NODE_ENV=development